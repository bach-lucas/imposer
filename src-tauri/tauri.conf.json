{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imposer",
  "version": "0.1.0",
  "identifier": "com.imposer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Imposer — Elden Ring",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false
      },
      {
        "label": "overlay",
        "title": "Imposer Overlay",
        "url": "index.html",
        "width": 680,
        "height": 560,
        "minWidth": 420,
        "minHeight": 320,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "focusable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
